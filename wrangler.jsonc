{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Producción (rama main). Staging usa el entorno "staging" de abajo.
  "name": "space-apps-2026",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "staging": {
      "name": "space-apps-2026-staging",
    },
  },
}
